{
  "name": "@decentnetwork/beagle-embed",
  "version": "0.2.2",
  "description": "A Beagle chat panel a host page can open on demand. Loads @decentnetwork/beagle-ui and the beagle-web peer only when the panel opens.",
  "license": "MIT",
  "type": "module",
  "main": "./src/open.js",
  "exports": {
    ".": "./src/open.js"
  },
  "files": [
