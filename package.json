    "measure": "node scripts/measure.mjs",
    "test": "node --test scripts/panel.test.mjs"
  },
  "dependencies": {
    "@decentnetwork/beagle-ui": "^0.2.40"
  },
  "devDependencies": {
    "playwright-core": "^1.48.2",
    "tweetnacl": "^1.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Decent-Network/beagle-embed.git"
